PORT=3001
HOST=127.0.0.1
APP_ORIGIN=https://exams.example.local
PUBLIC_APP_URL=https://exams.example.local
TRUST_PROXY=loopback
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=2592000
EXAM_SECONDS_PER_QUESTION_THEORY=60
EXAM_SECONDS_PER_QUESTION_ORAL=300
EXAM_SECONDS_PER_QUESTION_DRIVING=300
EXAM_SECONDS_PER_QUESTION_PERSONALITY=90
ARCHIVE_BACKUP_DIR=D:\ExamPlatformBackups\primary
ARCHIVE_BACKUP_MIRROR_DIR=\\backup-server\exam-platform\archive
ARCHIVE_BACKUP_ENCRYPTION_KEY=replace-with-a-separate-32-character-recovery-key
ARCHIVE_BACKUP_INTERVAL_SECONDS=300
ARCHIVE_BACKUP_RETENTION=72
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-14-character-password
INITIAL_COMMANDER_PASSWORD=replace-with-a-different-14-character-password
