{
  "name": "exam-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c gold,cyan \"npm run server\" \"vite\"",
    "server": "node server/index.js",
    "banks": "node scripts/generateBanks.mjs",
    "build": "tsc -b && vite build && node scripts/make-classic-build.mjs",
    "lint": "oxlint",
    "test": "node --test server/*.test.js",
    "check": "npm run lint && npm run test && npm run build",
    "load:test": "node scripts/load-test.mjs",
    "validate:production": "node scripts/validate-production.mjs",
    "start": "node server/runner.js",
    "test:committees": "node --test server/committees.test.js",
    "test:jobs": "node --test server/jobExams.test.js",
    "test:evaluations": "node --test server/evaluationSessions.test.js server/liveMonitor.test.js",
    "test:archive": "node --test server/archiveProtection.test.js server/backupLocation.test.js",
    "test:applicants": "node --test server/applicants.test.js",
    "committee:create": "node scripts/createCommitteeManager.mjs",
    "admin:password": "node scripts/set-admin-password.mjs",
    "passwords:reset": "node scripts/reset-default-passwords.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
